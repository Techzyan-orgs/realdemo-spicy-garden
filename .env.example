# =============================================================================
# THE SPICY GARDEN CAFE & BISTRO - ENVIRONMENT CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION
# Obtain these from your Supabase Project:
# https://supabase.com/dashboard -> Select Project -> Settings (Gear icon) -> API
# -----------------------------------------------------------------------------
# Public Project URL (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anon API Key (safe for browser, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Secret Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO BROWSER)
# Used for server-side order calculation, admin role verification, and system tasks
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# 2. WHATSAPP BUSINESS CLOUD API CONFIGURATION (OPTIONAL / OUTBOUND NOTIFICATIONS)
# Obtain from Meta for Developers -> WhatsApp -> API Setup:
# https://developers.facebook.com/apps/
# -----------------------------------------------------------------------------
# Permanent or System User Access Token with 'whatsapp_business_messaging' permission
WHATSAPP_ACCESS_TOKEN=EAAG...

# Phone Number ID from WhatsApp App Dashboard (typically 15 digits)
WHATSAPP_PHONE_NUMBER_ID=109283746592019

# WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321012345

# Official restaurant WhatsApp display number for customer inquiries (format: country code without + or spaces)
NEXT_PUBLIC_RESTAURANT_WHATSAPP=918777866602

# -----------------------------------------------------------------------------
# 3. FEATURE TOGGLES
# -----------------------------------------------------------------------------
# Enable/disable the privacy-conscious behavioral WhatsApp opt-in prompt
NEXT_PUBLIC_ENABLE_WHATSAPP_OPTIN=true

# Engagement score threshold required before showing the WhatsApp opt-in prompt
NEXT_PUBLIC_WHATSAPP_OPTIN_SCORE_THRESHOLD=10
